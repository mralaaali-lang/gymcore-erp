# Server
PORT=4000
NODE_ENV=production
TRUST_PROXY=false

# Database (Supabase/PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/gimawi_saas

# JWT — Access Token
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_EXPIRES_IN=24h

# QR Security
QR_SECRET_SALT=your-qr-hmac-salt-change-in-production

# CORS
CORS_ORIGIN=https://your-frontend-domain.com

# Browser app base URL used in password-reset emails.
# Required in staging/production (HTTPS); local Docker defaults to :9000.
FRONTEND_URL=https://your-frontend-domain.com

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your-dsn@sentry.io/your-project

# SMS Provider (optional)
SMS_API_KEY=
SMS_API_URL=

# Payment webhook signature verification (see middleware/webhookAuth.ts)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# Column-level encryption key (AES-256, 64 hex chars) — used by pgcrypto for
# encrypting phone_number and medical_notes at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
