{
  "name": "gymcore-erp",
  "version": "1.0.0",
  "description": "GymCore ERP - Multi-Tenant Gym Management Backend",
  "main": "dist/app.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/app.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop gymcore-backend",
    "restart:pm2": "pm2 restart gymcore-backend",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "migrate": "ts-node src/config/migrate.ts",
    "bootstrap:platform-admin": "ts-node src/scripts/bootstrap-platform-admin.ts",
    "cron": "ts-node src/cron/subscriptionCleanup.ts",
    "seed": "ts-node src/seed/seedPlayground.ts",
    "db:seed": "ts-node src/seed/seedPlayground.ts",
    "db:seed10": "ts-node src/seed/seedTenGyms.ts",
    "db:seed:engagement": "ts-node src/seed/seedEngagement.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest test/unit --forceExit",
    "test:int": "jest test/integration --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:vitest && npm run test:e2e",
    "db:rls-test-user": "node scripts/createRlsTestUser.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ]
  },
  "dependencies": {
    "@sentry/node": "^7.92.0",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^134.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "openai": "^6.49.0",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
