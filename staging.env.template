# ====================================================================
# GymCore ERP — Railway Staging Environment Template
# ====================================================================
# Railway Trial: $5/month credit (EXPIRES - not permanent free)
# Services sleep after ~30min inactivity (cold start 10-30s)
# No Docker Compose — each service separate (Backend, Frontend, PG, Redis)
# Ephemeral filesystem — uploads lost on redeploy
# NO REAL DATA — seedPlayground dummy data only
# ====================================================================
#
# COPY ORDER (CRITICAL):
# 1. Create Railway Project
# 2. Add PostgreSQL Service → Copy DATABASE_URL
# 3. Add Redis Service → Copy REDIS_URL
# 4. Create Backend Service (Dockerfile: server/Dockerfile.prod)
# 5. Create Frontend Service (Dockerfile: Dockerfile.prod)
# 6. SET BACKEND VARIABLES BELOW (including DATABASE_URL, REDIS_URL)
# 7. Deploy Backend → Get Backend URL
# 8. SET FRONTEND VARIABLES (VITE_API_URL = Backend URL + /api/v1)
# 9. Deploy Frontend → Get Frontend URL
# 10. UPDATE BACKEND CORS_ORIGIN = Frontend URL
# 11. RESTART BOTH SERVICES
# ====================================================================

# --------------------------------------------------------------------
# Application (Backend)
# --------------------------------------------------------------------
NODE_ENV=staging
PORT=4000
TRUST_PROXY=true
LOG_LEVEL=info

# --------------------------------------------------------------------
# Database (PostgreSQL) — COPY FROM RAILWAY POSTGRES SERVICE → Connect
# Format: postgresql://user:password@host:5432/database?sslmode=require
# --------------------------------------------------------------------
DATABASE_URL=

# --------------------------------------------------------------------
# Redis — COPY FROM RAILWAY REDIS SERVICE → Connect
# Format: redis://[:password@]host:6379
# --------------------------------------------------------------------
REDIS_URL=

# --------------------------------------------------------------------
# JWT — GENERATE BEFORE DEPLOY (32+ chars each)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --------------------------------------------------------------------
# QR Code Security — GENERATE BEFORE DEPLOY
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------
QR_SECRET_SALT=

# --------------------------------------------------------------------
# CORS — SET AFTER FIRST DEPLOY (must match Frontend URL exactly)
# Initial placeholder (will update after Frontend deploy):
# --------------------------------------------------------------------
CORS_ORIGIN=https://gymcore-frontend-placeholder.up.railway.app

# --------------------------------------------------------------------
# Frontend URL (for email links, password reset) — REQUIRED in staging.
# Set this to the public HTTPS URL returned after the frontend deploy.
# --------------------------------------------------------------------
FRONTEND_URL=

# --------------------------------------------------------------------
# Column-level Encryption (pgcrypto) — GENERATE BEFORE DEPLOY
# 64 hex chars (32 bytes) for AES-256
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------
ENCRYPTION_KEY=

# --------------------------------------------------------------------
# Sentry Error Tracking (optional)
# Get DSN from Sentry project settings
# --------------------------------------------------------------------
SENTRY_DSN=

# --------------------------------------------------------------------
# Email (SMTP) — Use Resend Free Tier for staging
# Mailpit is LOCAL ONLY — does not work on Railway
# --------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=GymCore Staging
SMTP_FROM_EMAIL=noreply@staging.gymcore.example.com

# --------------------------------------------------------------------
# SMS Provider (optional) — Unifonic, Twilio, etc.
# --------------------------------------------------------------------
SMS_API_KEY=
SMS_API_URL=

# --------------------------------------------------------------------
# Payment Webhook Signature Verification
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=

# --------------------------------------------------------------------
# Feature Flags / Staging-specific
# --------------------------------------------------------------------
# Enable playground seed on startup (creates demo gyms/members)
SEED_PLAYGROUND=true

# --------------------------------------------------------------------
# WebSocket (if running separate WS server)
# --------------------------------------------------------------------
WS_PORT=4001

# ====================================================================
# FRONTEND VARIABLES (set in Frontend Service Variables)
# ====================================================================
# VITE_API_URL=https://<backend-url>.up.railway.app/api/v1
# NODE_ENV=production
# ====================================================================
#
# SET ORDER:
# 1. Deploy Backend → Get Backend URL
# 2. Set VITE_API_URL = https://<backend-url>.up.railway.app/api/v1
# 3. Deploy Frontend → Get Frontend URL
# 4. Update Backend CORS_ORIGIN = Frontend URL
# 4. Restart Both Services
# ====================================================================
